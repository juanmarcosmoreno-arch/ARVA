# ARVA configuration (environment variables, prefix ARVA_).
# For local development copy to apps/api/.env.

ARVA_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/arva
ARVA_REDIS_URL=redis://localhost:6379/0

# Root of all managed data: raw/, results/, reports/, logs/.
# Raw files are stored read-only; keep this on a disk with enough space.
ARVA_STORAGE_ROOT=./data

# Maximum size of a single uploaded file in bytes (default 20 GB).
# ARVA_MAX_UPLOAD_SIZE_BYTES=21474836480

# Uploads and imports are refused if they would leave less than this much free
# space on the disk holding ARVA_STORAGE_ROOT (default 1 GiB). Browser uploads are
# buffered in the temporary directory (TMPDIR) first: when that is the same disk,
# they need twice their size while they are received.
# ARVA_MIN_FREE_BYTES=1073741824

# Reference databases installed by the Database Manager (Tools & Databases page), e.g.
# Bakta's database (light: about 1.3 GB to download and 3.9 GB unpacked; full: about
# 32 GB and 84 GB). Default: <ARVA_STORAGE_ROOT>/databases. Use a disk with room for
# the archive and the unpacked folder at the same time.
# ARVA_DB_DIR=/absolute/path/for/databases

# Server folders that can be browsed and imported from in the web interface
# (JSON list of absolute paths; empty disables server-side import). Files are
# copied into ARVA_STORAGE_ROOT; the originals are only read.
# ARVA_IMPORT_ROOTS=["/srv/sequencing/runs"]

# Existing database folders used where they are, read-only (JSON list; databases there can be registered and are
# never modified or deleted). With Docker, scripts/start.sh --add-databases sets it (/databases-external/<n>).
# ARVA_EXTERNAL_DB_ROOTS=["/srv/reference/bakta"]

# Performance (Settings → Performance in the web interface): ARVA chooses a profile (light, balanced, maximum)
# for this computer and gives each tool run its threads, memory limit and CPU priority. These two, when set, are
# administrator caps on every profile and every request: no tool run gets more threads or memory (GB).
# ARVA_TOOL_THREADS=8
# ARVA_TOOL_MEMORY_GB=16

# Facts about the computer (ARVA_HOST_PLATFORM, _MODEL_NAME, _MODEL_ID, _CHIP, _PERF_CORES, _EFF_CORES,
# _PHYSICAL_CORES, _LOGICAL_CPUS, _MEMORY_BYTES, _OS_VERSION, _ARCH, _DOCKER_CPUS, _DOCKER_MEMORY_BYTES) are set by
# scripts/start.sh on a Mac and passed to the containers by docker-compose.yml; do not set them here. With a plain
# `docker compose up` they stay empty and the profile follows the containers' CPUs and memory.

# Docker Compose only
# ARVA_DB_PASSWORD=choose-a-local-password
# Metadata backups (the backup service, into <data folder>/backups): hours between automatic backups, and how many
# of each kind (automatic, on request, before a restore) are kept.
# ARVA_BACKUP_INTERVAL_HOURS=24
# ARVA_BACKUP_KEEP=14
#
# Host folders (for example on an external disk) are no longer set here: docker-compose.yml uses Docker volumes, and
# scripts/start.sh mounts checked host folders instead and remembers them (docs/installation.md, External disk):
#   scripts/start.sh --data-dir /Volumes/<Disk>/ARVA/data --databases-dir /Volumes/<Disk>/ARVA/databases #                    --add-databases /Volumes/<Disk>/<existing database folder> --import-dir /Volumes/<Disk>/<runs>
# It passes the folders to the containers as ARVA_HOST_DATA_DIR, ARVA_HOST_DATABASES_DIR, ... (display only).
