# ARVA configuration (environment variables, prefix ARVA_).
# For local development copy to apps/api/.env.

ARVA_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/arva
ARVA_REDIS_URL=redis://localhost:6379/0

# Root of all managed data: raw/, results/, reports/, logs/.
# Raw files are stored read-only; keep this on a disk with enough space.
ARVA_STORAGE_ROOT=./data

# Maximum size of a single uploaded file in bytes (default 20 GB).
# ARVA_MAX_UPLOAD_SIZE_BYTES=21474836480

# Uploads and imports are refused if they would leave less than this much free
# space on the disk holding ARVA_STORAGE_ROOT (default 1 GiB).
# ARVA_MIN_FREE_BYTES=1073741824

# Server folders that can be browsed and imported from in the web interface
# (JSON list of absolute paths; empty disables server-side import). Files are
# copied into ARVA_STORAGE_ROOT; the originals are only read.
# ARVA_IMPORT_ROOTS=["/srv/sequencing/runs"]

# Docker Compose only
# ARVA_DB_PASSWORD=choose-a-local-password
# ARVA_DATA_DIR=/absolute/path/for/arva-data
# Host folder mounted read-only at /import (ARVA_IMPORT_ROOTS is set to it); default ./import
# ARVA_IMPORT_DIR=/absolute/path/to/sequencing/runs
