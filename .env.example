# ARVA configuration (environment variables, prefix ARVA_).
# For local development copy to apps/api/.env.

ARVA_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/arva
ARVA_REDIS_URL=redis://localhost:6379/0

# Root of all managed data: raw/, results/, reports/, logs/.
# Raw files are stored read-only; keep this on a disk with enough space.
ARVA_STORAGE_ROOT=./data

# Maximum size of a single uploaded file in bytes (default 20 GB).
# ARVA_MAX_UPLOAD_SIZE_BYTES=21474836480

# Docker Compose only
# ARVA_DB_PASSWORD=choose-a-local-password
# ARVA_DATA_DIR=/absolute/path/for/arva-data
